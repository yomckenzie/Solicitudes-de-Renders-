# Variables de entorno para Playwright Test
# Copiá este archivo a .env.test y completá las credenciales.
#
# Creá un usuario de prueba DEDICADO en Supabase (no uses tu usuario personal
# para que los tests puedan crear/borrar datos sin miedo).

TEST_USER_EMAIL=test-e2e@tuempresa.com
TEST_USER_PASSWORD=una-password-segura-12345

# Opcional: superadmin user para los admin tests (si lo creaste).
# Si no, los admin tests se saltean automáticamente.
TEST_SUPERADMIN_EMAIL=
TEST_SUPERADMIN_PASSWORD=