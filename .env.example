# ─── Supabase ──────────────────────────────────────────────────────────────
# Obtener de: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── NextAuth ──────────────────────────────────────────────────────────────
# Requerido en producción. Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=tu-secret-de-32-bytes-minimo
# En Vercel, esto se auto-detecta. Solo setear si tienes un dominio custom o deploys en subpath.
# NEXTAUTH_URL=https://tu-dominio.com

# ─── Opcional: para scripts de migración ──────────────────────────────────
# SUPABASE_PROJECT_REF=tuproyecto
# SUPABASE_ACCESS_TOKEN=sbp_xxx
